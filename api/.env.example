DJANGO_SECRET_KEY=replace-with-a-long-random-secret
LEDGER_INTEGRITY_KEY=replace-with-a-separate-long-random-secret-and-keep-it-permanently
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=api.example.com
POSTGRES_DB=ilovemini
POSTGRES_USER=ilovemini
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
NAVER_CLIENT_ID=from-naver-developers
NAVER_CLIENT_SECRET=keep-only-on-server
NAVER_REDIRECT_URI=https://api.example.com/api/auth/naver/callback/
MOBILE_AUTH_REDIRECT_URI=ilovemini://auth
FCM_ENABLED=0
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-admin.json
# FIREBASE_ADMIN_KEY_FILE=/absolute/path/to/firebase-admin-service-account.json
